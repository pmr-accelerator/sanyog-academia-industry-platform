# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to ".env" (Windows:  copy .env.example .env) and edit it.
# NEVER commit ".env". It is listed in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=development
PLATFORM_NAME=Sanyog                 # change this to rename the platform (restart the server)
PORT=4000
CLIENT_ORIGIN=http://localhost:5173  # exact browser origin of the web app (used for CORS + CSRF origin check)

# Database (matches docker-compose.yml). Change the password for anything beyond local development.
DB_PASSWORD=change_me_local_only
DATABASE_URL=postgresql://sanyog:change_me_local_only@localhost:5432/sanyog?schema=public

# Secrets. Generate each with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Required (32+ chars) in production. In development, empty values mean "random per start" (sessions reset on restart).
SESSION_SECRET=
CREDENTIAL_SIGNING_KEY=

# Cookies. Production: COOKIE_SECURE=true (HTTPS). Use COOKIE_SAMESITE=none only if the web app and API are on
# different sites (requires HTTPS). Set TRUST_PROXY=true when running behind a reverse proxy / load balancer.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
TRUST_PROXY=false

# Private file storage (never served directly). Relative paths are resolved from the server/ folder.
UPLOAD_DIR=./storage/uploads
MAX_UPLOAD_MB=5

# Email. "console" prints verification/reset links to the server terminal (development only).
MAIL_TRANSPORT=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@example.invalid

# AI roadmap provider. Leave AI_PROVIDER=none to use the labelled rule-based fallback (no key needed).
# Supported adapters: openai (also any OpenAI-compatible API via AI_BASE_URL), anthropic.
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=
AI_TIMEOUT_MS=20000
AI_DAILY_LIMIT_PER_USER=10

# Demonstration data. DEMO_MODE=true lists the demo account emails on the login page; it is refused in production.
DEMO_MODE=true
# Password for ALL seeded demo accounts (min 12 chars). Choose your own; it is never printed or committed.
SEED_DEMO_PASSWORD=
