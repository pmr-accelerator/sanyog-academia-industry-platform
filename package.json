{
  "name": "academia-industry-platform",
  "version": "0.1.0",
  "private": true,
  "description": "College-mediated academia\u2013industry collaboration platform",
  "engines": {
    "node": ">=20.11.0"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "db:up": "docker compose up -d db",
    "db:migrate": "npm run prisma:migrate --workspace server",
    "db:seed": "npm run seed --workspace server",
    "dev": "concurrently -n server,client -c blue,green \"npm run dev --workspace server\" \"npm run dev --workspace client\"",
    "build": "npm run build --workspace client",
    "test": "npm run test --workspace server && npm run test --workspace client",
    "setup": "npm install && npm run db:up && npm run db:migrate && npm run db:seed",
    "prisma:validate": "npm run prisma:validate --workspace server",
    "test:unit": "npm run test:unit --workspace server && npm run test --workspace client",
    "test:integration": "npm run test:integration --workspace server",
    "create-admin": "npm run create-admin --workspace server",
    "start": "npm run start --workspace server",
    "jobs:run": "npm run jobs:run --workspace server",
    "db:reset": "npm run seed --workspace server -- --reset",
    "test:offline": "npm run test:unit",
    "db:migration:baseline": "node scripts/create-baseline-migration.mjs",
    "test:release": "npm run prisma:validate && npm run test:unit && npm run build",
    "test:e2e": "node tests/e2e/smoke.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.0.0",
    "playwright": "^1.55.0"
  }
}
